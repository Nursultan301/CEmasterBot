#, python-format
msgid "*%(index)d.* Tracking number: `%(track)s`\n"
msgstr "*%(index)d.* Трек номери: `%(track)s`\n"

#: src/infrastructures/aiogram/routers/commands/base_commands.py:199
#, python-format
msgid "• Weight: *%(weight).2f kg*\n"
msgstr "• Салмагы: *%(weight).2f кг*\n"

#: src/infrastructures/aiogram/routers/commands/base_commands.py:200
#, python-format
msgid "• Price: *%(price)s*\n"
msgstr "• Баасы: *%(price)s*\n"

#: src/infrastructures/aiogram/routers/commands/base_commands.py:201
#, python-format
msgid "• Status: *%(status)s*\n"
msgstr "• Стутусу: *%(status)s*\n"

#: src/infrastructures/aiogram/routers/commands/base_commands.py:221
msgid ""
"📦 No shipments yet\n"
"\n"
"As soon as a shipment arrives at the warehouse, it will appear in this "
"section."
msgstr ""
"📦 Азырынча посылкалар жок\n"
"\n"
"Посылка кампага келгенде, бул бөлүмдө автоматтык түрдө көрүнөт."

